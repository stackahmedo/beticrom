# =============================================================================
# Beticrom E-Commerce Admin Panel & Storefront CMS — Environment Configuration
# Copy to .env for local overrides. NEVER commit real secrets to git.
# =============================================================================

# Runtime
NODE_ENV=development
API_PORT=3001
APP_ORIGIN=http://localhost:5173

# Database
# Leave DATABASE_URL empty in local development to automatically use embedded
# persistent PostgreSQL 16 (PGlite) stored at ./.local/pgdata.
# Set DATABASE_URL to a Supabase/PostgreSQL connection string for external DB.
DATABASE_URL=
PGLITE_DATA_DIR=./.local/pgdata

# Security & Sessions
# Generate a random 32+ byte secret for production: openssl rand -hex 32
SESSION_SECRET=change-me-in-production-min-32-chars
MFA_ENCRYPTION_KEY=change-me-in-production-min-32-chars

# Development Seeding (ONLY active when NODE_ENV=development AND ENABLE_DEV_SEED=true)
ENABLE_DEV_SEED=true
DEV_ADMIN_EMAIL=admin@beticrom.jp
DEV_ADMIN_PASSWORD=ChangeMe!2026

# Optional: Supabase Auth Integration (if authenticating via Supabase JWT)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Optional: Cloudflare R2 Media Storage (falls back to ./.local/uploads when unset)
MEDIA_STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Optional: Resend Transactional Email (falls back to DB email_outbox when unset)
RESEND_API_KEY=
EMAIL_FROM=noreply@beticrom.jp

# Optional: Payment Gateway Webhook Secrets (HMAC-SHA256 verification)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAY_API_KEY=
PAYPAY_WEBHOOK_SECRET=
